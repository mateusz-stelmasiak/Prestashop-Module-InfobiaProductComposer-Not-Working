# Uploaded files are data, never code: refuse to serve anything executable.
<FilesMatch "\.(php[0-9]?|pht|phtml|phar|inc|pl|py|cgi|sh|shtml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
